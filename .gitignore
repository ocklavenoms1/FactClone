# Godot 4+ specific ignores

# Editor cache and import metadata regenerated on first open.
.godot/

# Older Godot import folder, harmless to ignore.
.import/

# Mono / .NET (we use GDScript, but ignore in case of future C# experiments).
.mono/
data_*/

# Translation artifacts.
*.translation

# OS / editor cruft.
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# Claude Code per-project local settings (permissions, tool toggles).
.claude/settings.local.json

# Build / export outputs. Godot exports to wherever you point Project →
# Export, but if you ever export INTO the repo (e.g. ./build/), this
# keeps binaries out of git. Adjust paths if you settle on a different
# build folder convention.
build/
exports/
*.exe
*.pck
*.so
*.dylib
*.dll
*.dmg
*.zip

# Art pipeline. Sprites and their sidecars ARE committed — the game loads them.
# The 4x masters are large, regenerable intermediates; source GLBs are large
# binaries that live with the Tripo account, not in git history.
art/renders/*_4x.png
art/renders/turnaround/
art/source/*.glb
# ...except the permanent HF calibration object, which MUST be committed
!art/source/_calib_floor.glb

art/renders/_calib*
art/renders/tex/
art/renders/tex_full/

# byte-cache from art/tools importing art/blender/lock.py
__pycache__/
*.pyc
